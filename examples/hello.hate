// Hello Hate!
// A demonstration of the Hate programming language

println("=== Welcome to Hate! ===");
println("");

// Variables
let name = "Developer";
let age = 25;
println("Hello, " + name + "!");
println("Age: " + age);

// Arithmetic
println("");
println("=== Math Operations ===");
println("5 + 10 = " + (5 + 10));
println("20 - 8 = " + (20 - 8));
println("6 * 7 = " + (6 * 7));
println("100 / 4 = " + (100 / 4));
println("1 + 2 * 3 = " + (1 + 2 * 3));

// String concatenation
println("");
println("=== Strings ===");
let greeting = "Hello";
let target = "World";
println(greeting + ", " + target + "!");

// Expressions
println("");
println("=== Expressions ===");
let x = 10;
let y = 20;
let sum = x + y;
println("x = " + x);
println("y = " + y);
println("x + y = " + sum);

println("");
println("=== Done! ===");
